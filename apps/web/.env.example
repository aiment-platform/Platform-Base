# Cloudflare R2 (画像ストレージ)
# ローカルで画像アップロードを試す場合は apps/web/.env.local にコピーして実値を入れる。
# 本番/プレビューは Vercel の Environment Variables に登録する。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aiment-assets
# r2.dev or カスタムドメイン。例: https://pub-xxxx.r2.dev / https://cdn.aiment.jp
R2_PUBLIC_BASE_URL=

# セッションCookieの署名鍵(必須・本番)。未設定だと本番では誰もログインできない。
# 生成例: openssl rand -base64 48
# ローカル/E2Eでは未設定でも開発用の固定値で動く。
SESSION_SECRET=
