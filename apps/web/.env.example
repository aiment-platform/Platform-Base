# Cloudflare R2 (画像ストレージ)
# ローカルで画像アップロードを試す場合は apps/web/.env.local にコピーして実値を入れる。
# 本番/プレビューは Vercel の Environment Variables に登録する。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aiment-assets
# r2.dev or カスタムドメイン。例: https://pub-xxxx.r2.dev / https://cdn.aiment.jp
R2_PUBLIC_BASE_URL=

# セッションCookieの署名鍵(必須・本番)。未設定だと本番では誰もログインできない。
# 生成例: openssl rand -base64 48
# ローカル/E2Eでは未設定でも開発用の固定値で動く。
SESSION_SECRET=

# 配信の録画（管理者だけがダウンロードできるアーカイブ）
# 録画用のバケットは「公開しない」こと。上の R2_BUCKET（画像用）は誰でも読めるので使わない。
# 未設定なら録画はしない（配信には影響しない）。R2_ACCOUNT_ID と LiveKit の設定も必要。
R2_RECORDINGS_BUCKET=
# 任意: 録画は LiveKit に鍵を渡して R2 へ書き込んでもらうので、録画用バケットだけに絞った鍵を分けられる。
# 空なら R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY を使う。
R2_RECORDINGS_ACCESS_KEY_ID=
R2_RECORDINGS_SECRET_ACCESS_KEY=
# 任意: 「全部入り」録画の画面（/recording-template）を開く元の URL。LiveKit から見える URL であること。
# 空なら配信者がアクセスしているサイトの URL を使う。localhost のときは LiveKit 標準の画面で録る。
RECORDING_TEMPLATE_BASE_URL=
